{
  "manifest_version": 3,
  "name": "GlideLens",
  "version": "0.13.0",
  "description": "A lens on ServiceNow forms, catalogs and code: code search, catalog debugging, translation inheritance, form tracing.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://*.service-now.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GlideLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.service-now.com/*"],
      "js": ["debug_timeline_ui.js", "hidden_variables_ui.js", "catalog_insight_ui.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/drag-indicator.svg"],
      "matches": ["https://*.service-now.com/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  }
}
